{
  "name": "cookiecare-mastra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run kb:migrate",
    "dev": "mastra dev",
    "prestart": "npm run kb:migrate",
    "start": "mastra start",
    "build": "mastra build",
    "kb:migrate": "tsx src/mastra/knowledge-base/ingestion/storage/migrate-cli.ts",
    "prekb:worker": "npm run kb:migrate",
    "kb:worker": "tsx src/mastra/knowledge-base/ingestion/worker-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/mastra/knowledge-base/ingestion/tests/*.test.ts",
    "kb:evaluate": "tsx src/mastra/knowledge-base/ingestion/evaluation/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@mastra/core": "1.75.0",
    "@mastra/pg": "^1.30.0",
    "docling.rs": "1.41.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "mastra": "1.33.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2"
  }
}
