        "ref": "dsn_5d85f0aff5caccc6e125afea",
        "quotedText": "4 Third Party Notifications. Administrator is solely responsible for complying with breach notification laws applicable to Administrator and fulfilling any third party notification obligations related to any Data Incident.",
        "structuralPath": "document.list_item_(c)~3.list_item_80",
        "charRange": [
          20181,
          20403
