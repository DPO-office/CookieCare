      },
      {
        "spanId": "dsn_9e185b210059eb27b5b556b3",
        "ref": "dsn_9e185b210059eb27b5b556b3",
        "quotedText": "(i) the Sub-processor only accesses and uses Personal Data to the extent required to perform the obligations subcontracted to it, and does so in accordance with the Agreement (including this DPA); and",
        "structuralPath": "document.list_item_(i)",
        "charRange": [
          17027,
