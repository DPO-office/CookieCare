        ],
        "investigationConfidence": 0.85
      },
      {
        "spanId": "dsn_7368c59386145b8609e47989",
        "ref": "dsn_7368c59386145b8609e47989",
        "quotedText": "1 Incident Notification. If Alaio becomes aware of a Data Incident, Alaio will: (a) notify Administrator of the Data Incident promptly and without undue delay; and (b) promptly take reasonable steps to minimize the harm and secure Personal Data.",
        "structuralPath": "document.list_item_(c)~3.list_item_77",
        "charRange": [
          19356,
          19601
        ],
        "scope": {
          "documentId": "doc_f78d0984-9ab5-4d73-b963-d2e56017da49",
          "structuralPath": "document.list_item_(c)~3.list_item_77"
        },
        "source": "seed",
        "evidenceRole": "supporting",
        "contributesToElementIds": [
          "measures_and_mitigation"
        ],
        "investigationConfidence": 0.75
      },
      {
        "spanId": "dsn_1d28a3bd5bc7f471cd9bcac1",
        "ref": "dsn_1d28a3bd5bc7f471cd9bcac1",
        "quotedText": "'Data Incident' means a breach of Bitrix24 security leading to the accidental or unlawful destruction, loss, alteration, unauthorised disclosure of, or access to, User Personal Data on systems managed by or otherwise controlled by Alaio . 'Data Incidents' will not include unsuccessful attempts or activities that do not compromise the security of User Personal Data, including unsuccessful log-in attempts, pings, port scans, denial of service attacks, and other network attacks on firewalls or networked systems.",
        "structuralPath": "document.clause_1.subclause_1.1.paragraph_20",
        "charRange": [
          2793,
          3307
        ],
        "scope": {
          "documentId": "doc_f78d0984-9ab5-4d73-b963-d2e56017da49",
          "structuralPath": "document.clause_1.subclause_1.1.paragraph_20"
        },
        "source": "expansion",
        "evidenceRole": "definition",
        "contributesToElementIds": [],
        "investigationConfidence": 0.9
      },
      {
        "spanId": "dsn_5868468303f05ea53302e20d",
        "ref": "dsn_5868468303f05ea53302e20d",
        "quotedText": "'Processing of personal data' means any operation or set of operations which is performed upon Personal Data, whether or not by automatic means, such as collection, recording, organization, storage, adaptation or alteration, retrieval, consultation, use, disclosure by transmission, dissemination or otherwise making available, alignment or combination, blocking, erasure or destruction ('Process', 'Processes' and 'Processed' shall have the same meaning).",
        "structuralPath": "document.clause_1.subclause_1.1.list_item_26",
        "charRange": [
          6232,
          6688
        ],
        "scope": {
          "documentId": "doc_f78d0984-9ab5-4d73-b963-d2e56017da49",
          "structuralPath": "document.clause_1.subclause_1.1.list_item_26"
        },
        "source": "expansion",
        "evidenceRole": "definition",
        "contributesToElementIds": [],
        "investigationConfidence": 0.9
      },
      {
        "spanId": "dsn_88a2714c1f05ef6ff4da0e1c",
        "ref": "dsn_88a2714c1f05ef6ff4da0e1c",
        "quotedText": "The supervisory authority of the single establishment of Alaio within the EEA competent to act  as  lead  supervisory  authority  for  the  cross-border  processing  carried  out  by  that processor in accordance with the procedure provided in Article 60 of GDPR is the supervisory authority of Cyprus.",
        "structuralPath": "document.clause_12.subclause_12.3.paragraph_107",
