    {
      "findingId": "f_verify_cov_gdpr.article28.controller_obligations_and_rights_wu-eval-gdpr.art28.particulars",
      "kind": "compliance",
      "category": "gdpr.art28.3.chapeau.mandatory_processing_agreement_particulars_gap",
      "status": "present",
      "claim": "The words \"You will... ensure all instructions given by You... are at all times in accordance with Data Protection Laws\" and \"have all authorizations and/or consents necessary\" explicitly set out the controller's obligations regarding lawful instructions and legal basis.",
      "evidence": [
        {
          "locator": {
            "docId": "dpa",
            "structuralPath": "clause-2.3",
            "charRange": [
              7590,
              8827
            ]
          },
          "quotedText": "You will: a. use the Cisco Offers in compliance with Data Protection Laws; b. ensure all instructions given by You to Cisco in respect of the Processing of Personal Data are at all times in accordance with Data Protection Laws; c. ensure all Personal Data provided to Cisco has been collected in accordance with Data Protection Laws and that You have all authorizations and/or consents necessary to provide such Personal Data to Cisco;",
          "sourceRole": "target"
        }
      ],
