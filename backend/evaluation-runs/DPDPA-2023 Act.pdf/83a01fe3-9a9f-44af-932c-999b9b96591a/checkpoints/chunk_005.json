      {
        "id": "src:20",
        "start": 938,
        "end": 1210,
        "text": "An Act to provide for the processing of digital personal data in a manner that recognises both the right of individuals to protect their personal data and the need to process such personal data for lawful purposes and for matters connected therewith or incidental thereto.",
        "group": "native:4",
        "headings": [
