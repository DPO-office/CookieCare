{
  "name": "lora-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/setupDb.ts && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js && node server.js",
    "build": "node ../scripts/build-backend.mjs",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "kb:evaluate": "tsx src/mastra/knowledge-base/ingestion/evaluation/run.ts",
    "test:kb": "node --import tsx --test src/mastra/knowledge-base/ingestion/tests/*.test.ts",
    "lint:kb": "tsc --noEmit --project tsconfig.mastra.json",
    "setup-db": "tsx scripts/setupDb.ts",
    "compliance:qualify": "tsx scripts/compliance-qualification-report.ts",
    "lint": "tsc --noEmit",
    "lint:skills": "node --import ./node_modules/tsx/dist/loader.mjs src/modules/analysis/skills/runtime/lint/run-lint-skill-parity.ts",
    "audit:skills:investigation": "node --import ./node_modules/tsx/dist/loader.mjs src/modules/analysis/skills/runtime/lint/run-audit-investigation-profiles.ts",
    "test": "npm run lint:skills && node --import ./node_modules/tsx/dist/loader.mjs --test test/**/*.test.ts src/modules/analysis/skills/__fixtures__/**/*.test.ts src/modules/analysis/capabilities/**/__fixtures__/**/*.test.ts src/modules/drafting/capabilities/**/__fixtures__/**/*.test.ts src/modules/compare/__fixtures__/**/*.test.ts",
    "test:compare": "node --import ./node_modules/tsx/dist/loader.mjs --test src/modules/compare/__fixtures__/**/*.test.ts src/utils/__fixtures__/extractText.test.ts",
    "test:compliance": "node --import ./node_modules/tsx/dist/loader.mjs --test src/modules/analysis/capabilities/act/compliance/**/__fixtures__/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@google/genai": "^2.11.0",
    "@google/generative-ai": "^0.24.1",
    "@mastra/core": "1.75.0",
    "@mastra/pg": "1.30.0",
    "@sentry/node": "^10.56.0",
    "@sentry/profiling-node": "^10.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-type": "^22.0.1",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "pdf-parse-fork": "^1.2.0",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.25.0",
    "mastra": "1.33.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "docling.rs": "1.41.0"
  }
}
