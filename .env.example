# Copy to .env on the main Droplet and supply production values. Never commit .env.
# DATABASE_URL must use the same credentials below, URL-encode reserved password characters,
# and use the Compose hostname db (not localhost).
POSTGRES_DB=lora
POSTGRES_USER=lora_app
POSTGRES_PASSWORD=
DATABASE_URL=
ENCRYPTION_KEY=
JWT_SECRET=
CORS_ORIGIN=https://your-lora-host.example
LORA_DOMAIN=your-lora-host.example
GOOGLE_CLOUD_PROJECT=
GOOGLE_GEMINI_EXTERNAL_KEY=
LLM_GENERATION_PROVIDER=digitalocean
# Create a DigitalOcean Inference model access key scoped to the selected models.
DO_MODEL_ACCESS_KEY=
DO_LLM_FAST_MODEL=glm-5.3-flash
DO_LLM_REASONING_MODEL=glm-5.3
KB_EVAL_JUDGE_MODEL=glm-5.3
DOCLING_SERVICE_URL=https://docling.internal.example/
DOCLING_SERVICE_TOKEN=

# Keep disabled until Knowledge Base ingestion work resumes.
KB_INGESTION_ENABLED=false
# Optional until Knowledge Base processing is enabled. Set all four together.
# Use a private DigitalOcean Space and bucket-scoped Spaces key.
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
KB_WORKER_CONCURRENCY=2
KB_STRUCTURE_PROVIDER=kanon
# Set to llm to use DigitalOcean for KB structure extraction, or replay a saved Docling run.
KB_STRUCTURE_LLM_MODEL=glm-5.3

# Compose binds the API to loopback for local diagnostics.
LORA_HTTP_PORT=8080
