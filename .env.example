# Copy to .env on the Droplet and supply production values. Never commit .env.
DATABASE_URL=postgresql://user:password@database-host:5432/lora
ENCRYPTION_KEY=
JWT_SECRET=
CORS_ORIGIN=https://your-lora-host.example
LORA_DOMAIN=your-lora-host.example
GOOGLE_CLOUD_PROJECT=
GOOGLE_GEMINI_EXTERNAL_KEY=

# Knowledge base storage. Use a private S3 bucket and credentials with bucket access.
AWS_REGION=
KB_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KB_WORKER_CONCURRENCY=2

# Compose binds the API to loopback for an existing HTTPS reverse proxy.
LORA_HTTP_PORT=8080
